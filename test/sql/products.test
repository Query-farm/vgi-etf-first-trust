# name: test/sql/products.test
# description: firsttrust.products — base table: typed schema (network-free) + live catalog invariants.
# group: [sql]

require-env VGI_TEST_WORKER

statement ok
ATTACH 'firsttrust' AS ft (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

statement ok
SET search_path='ft.main';

# --- Schema: DESCRIBE binds only (no network), so these are fully deterministic. ---
# `products` is a base TABLE — query it with no parentheses.

query T
SELECT column_type FROM (DESCRIBE SELECT * FROM ft.products) WHERE column_name = 'ticker';
----
VARCHAR

query T
SELECT column_type FROM (DESCRIBE SELECT * FROM ft.products) WHERE column_name = 'nav';
----
DOUBLE

query T
SELECT column_type FROM (DESCRIBE SELECT * FROM ft.products) WHERE column_name = 'inception_date';
----
DATE

query T
SELECT column_type FROM (DESCRIBE SELECT * FROM ft.products) WHERE column_name = 'sec_yield_30day_percent';
----
DOUBLE

# --- Live invariants: these hit First Trust. Assert shape, not exact (moving) values. ---

# The catalog has many funds; filter with WHERE.
query I
SELECT (count(*) > 50)::INT FROM ft.products;
----
1

# FTCS (First Trust Capital Strength ETF) is present with a positive NAV.
query I
SELECT (count(*) = 1)::INT FROM ft.products WHERE ticker = 'FTCS' AND nav > 0;
----
1

# The fund-type category is populated for the lineup.
query I
SELECT (count(DISTINCT category) >= 1)::INT FROM ft.products WHERE category IS NOT NULL;
----
1
