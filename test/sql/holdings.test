# name: test/sql/holdings.test
# description: firsttrust.holdings base table — fund_ticker partition (pushdown), current holdings only.
# group: [sql]

require-env VGI_TEST_WORKER

statement ok
ATTACH 'firsttrust' AS ft (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

statement ok
SET search_path='ft.main';

# --- Schema: DESCRIBE binds only (no network). `holdings` is a base TABLE. ---

query T
SELECT string_agg(column_name, ',') FROM (DESCRIBE SELECT * FROM ft.holdings WHERE fund_ticker = 'FTCS');
----
fund_ticker,as_of_date,weight_percent,ticker,name,cusip,sector,shares_held,market_value

query T
SELECT column_type FROM (DESCRIBE SELECT * FROM ft.holdings WHERE fund_ticker = 'FTCS') WHERE column_name = 'as_of_date';
----
DATE

# --- Live invariants (hit First Trust). ---

# Partition pushdown: WHERE fund_ticker = 'FTCS' fetches that fund's holdings, weight-descending.
query I
SELECT (count(*) > 40 AND max(weight_percent) > 0 AND bool_and(fund_ticker = 'FTCS'))::INT
FROM ft.holdings WHERE fund_ticker = 'FTCS';
----
1

# Multiple partitions at once: fund_ticker IN (...) fans out to two funds.
query I
SELECT (count(DISTINCT fund_ticker) = 2)::INT FROM ft.holdings WHERE fund_ticker IN ('FTCS', 'AIRR');
----
1

# An unfiltered scan is allowed — it streams EVERY fund's holdings (one partition per fund).
# LIMIT short-circuits the stream after the first partition, so this stays cheap.
query I
SELECT (count(*) >= 1)::INT FROM (SELECT * FROM ft.holdings LIMIT 5);
----
1

# The backing scan function also works directly (pushdown).
query I
SELECT (count(*) > 40)::INT FROM ft.holdings_scan() WHERE fund_ticker = 'FTCS';
----
1
